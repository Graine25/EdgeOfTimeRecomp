@@ -3153,6 +3153,13 @@ namespace plume {
         psoDesc.DepthStencilState.BackFace.StencilDepthFailOp = toD3D12(desc.stencilBackFace.depthFailOp);
         psoDesc.DepthStencilState.BackFace.StencilPassOp = toD3D12(desc.stencilBackFace.passOp);
         psoDesc.DepthStencilState.BackFace.StencilFunc = toD3D12(desc.stencilBackFace.compareFunction);
+        // D3D12 keeps the stencil reference out of the PSO - it is command list
+        // state, applied by checkStencilRef through OMSetStencilRef - so it has
+        // to be carried on the pipeline for that call to find. Every other
+        // stencil field above was wired up and this one was not, which left the
+        // reference at its default of zero for every draw. The Vulkan and Metal
+        // backends both take it from the desc.
+        stencilRef = desc.stencilEnabled ? desc.stencilReference : 0;
         psoDesc.NumRenderTargets = desc.renderTargetCount;
         psoDesc.BlendState.AlphaToCoverageEnable = desc.alphaToCoverageEnabled;
 
